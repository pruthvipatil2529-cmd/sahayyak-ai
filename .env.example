# Sahayyak AI Environment Configuration

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Default: local SQLite database, or set PostgreSQL URI)
DATABASE_URL=sqlite:///./sahayyak.db
# Example PostgreSQL: postgresql://user:password@localhost:5432/sahayyak_db

# Security & Authentication
JWT_SECRET=sahayyak_super_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider (Google Gemini API)
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
